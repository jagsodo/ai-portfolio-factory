# === Telegram ===
# From @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me
# Secret token sent as X-Telegram-Bot-Api-Secret-Token header (configured when registering the webhook)
TELEGRAM_WEBHOOK_SECRET=replace-with-long-random-string
# Allowed Telegram user ID (numeric). Only this user may command the bot.
TELEGRAM_OWNER_USER_ID=000000000
# Allowed chat ID (usually equal to owner user ID for a private chat)
TELEGRAM_ALLOWED_CHAT_ID=000000000

# === GitHub ===
# Fine-grained PAT with scope limited to the single target repository.
GITHUB_TOKEN=github_pat_replace_me
# "owner/repo" of the factory repository (used for Issues/Actions dispatch).
GITHUB_REPO=your-user/ai-portfolio-factory
# Default branch for pull requests to merge into.
GITHUB_DEFAULT_BRANCH=main

# === Claude Code auth (only ONE of these must be set in GitHub Actions secrets) ===
# Preferred for API-pay-per-use setups.
ANTHROPIC_API_KEY=
# Alternative when the Claude subscription supports it. Only used if ANTHROPIC_API_KEY is empty.
CLAUDE_CODE_OAUTH_TOKEN=

# === Agent limits ===
AGENT_MAX_TURNS=25
AGENT_DAILY_LIMIT=1

# === Idempotency backend (Vercel serverless cannot use in-memory state) ===
# Set to "redis" in production. Leave unset or "memory" only for local dev.
IDEMPOTENCY_BACKEND=memory
# Upstash Redis REST credentials. Free tier: 10,000 commands/day.
# Create a database at https://console.upstash.com, pick "Global", copy the
# "REST URL" and "REST Token" shown on the database page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
